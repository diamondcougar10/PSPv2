<resources>
    <!-- No ActionBar; Compose draws the whole UI. Uses the platform Material theme so
         no AppCompat dependency is required. Display-cutout handling lives in
         values-v27/themes.xml because the attribute requires API 27 (min is 26). -->
    <style name="Theme.PSPV2" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
